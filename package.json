{
  "name": "job-track",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.backend.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,json,jsonc}\"",
    "check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,json,jsonc}\"",
    "typecheck": "tsrs --noEmit",
    "typecheck:backend": "tsrs --noEmit -p convex/tsconfig.json",
    "cf:deploy": "cf deploy",
    "typecheck:design-system": "tsrs --noEmit -p design-system/tsconfig.json",
    "design-system:build": "vite build --config design-system.vite.config.ts",
    "design-system:export": "pnpm design-system:build && node scripts/export-design-system.mjs",
    "design-system:dev": "vite --config design-system.vite.config.ts --port 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@convex-dev/r2": "0.10.4",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@workos/authkit-tanstack-react-start": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "effect": "4.1.2",
    "jose": "6.2.15",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@edge-runtime/vm": "^5.0.0",
    "@oxlint/plugins": "1.90.0",
    "@shadcn/lint": "0.2.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.26",
    "convex-test": "0.0.66",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
