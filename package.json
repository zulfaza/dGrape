{
  "name": "job-track",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,json,jsonc}\"",
    "check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,json,jsonc}\"",
    "typecheck": "tsrs --noEmit",
    "typecheck:backend": "tsrs --noEmit -p convex/tsconfig.json",
    "cf:deploy": "cf deploy",
    "typecheck:design-system": "tsrs --noEmit -p design-system/tsconfig.json",
    "design-system:build": "vite build --config design-system.vite.config.ts",
    "design-system:export": "pnpm design-system:build && node scripts/export-design-system.mjs",
    "design-system:dev": "vite --config design-system.vite.config.ts --port 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@convex-dev/r2": "0.10.4",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@workos/authkit-tanstack-react-start": "^0.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "effect": "4.1.1",
    "jose": "6.2.3",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "^4.11.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@tanstack/devtools-vite": "^0.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cf": "1.0.0-beta.26",
    "jsdom": "^28",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
