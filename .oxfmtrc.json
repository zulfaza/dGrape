{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "tools/oxlint/anti-slop/**",
    ".agents/**"
  ],
  "sortTailwindcss": {
    "stylesheet": "./src/app.css",
    "functions": ["cn", "cva"]
  }
}
